rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un utente può leggere e scrivere solo il proprio documento profilo...
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ...e tutte le proprie sottocollezioni (reviews, quizSessions, kanjiStats, ...).
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tutto il resto è negato di default.
  }
}
