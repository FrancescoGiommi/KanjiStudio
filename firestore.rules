rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un utente può leggere e scrivere solo il proprio documento profilo...
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ...e le proprie carte di ripasso a ripetizione spaziata.
      match /reviews/{character} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tutto il resto è negato di default.
  }
}
